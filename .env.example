# Salin ke .env.local lalu isi nilainya.
ADMIN_PASSWORD=ganti-password-ini
ADMIN_SECRET=ganti-dengan-string-acak-panjang

# URL publik situs — dipakai untuk metadata, sitemap, dan RSS.
# NEXT_PUBLIC_SITE_URL=https://domain-anda.com

# Opsional — untuk deployment dengan persistent volume (Railway, VPS, dll).
# ANKA_DATA_DIR=/app/storage/data
# ANKA_UPLOADS_DIR=/app/storage/uploads/products
# ANKA_SEED_FILE=/app/data/content.seed.json
